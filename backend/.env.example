# ====================================
# 🔒 Template de Variables de Entorno
# ====================================
# Copiar este archivo como .env y completar con valores reales
# ====================================

# Base de Datos PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/dioburger
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# Zona horaria del backend. IMPRESCINDIBLE en el deploy (Render/Railway corren en UTC):
# sin esto, los filtros "de hoy" de Pedidos y Dashboard pierden los pedidos de la noche.
TZ=America/Argentina/Buenos_Aires

# CORS: dominios del frontend, coma-separado. En dev el default alcanza.
# En el deploy: CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT (JSON Web Token) - Autenticación
# ⚠️ Generar un secret seguro con al menos 32 caracteres
# Ejemplo: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
JWT_EXPIRATION=86400000

# Bot API Key (uso interno/testing del bot)
BOT_API_KEY=your_bot_api_key_here

# ====================================
# Meta (WhatsApp / Instagram / Facebook) - Integración directa, sin n8n
# ====================================
# Token propio que Meta debe repetir al verificar el webhook (vos lo elegís)
META_WEBHOOK_VERIFY_TOKEN=your_meta_verify_token_here
# Si es true, no se llama a Graph API real (solo se loguea la respuesta) - útil para dev
DRY_RUN_META_SEND=true
META_GRAPH_API_VERSION=v20.0

# OpenAI - interpretación de mensajes de texto del bot
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Google AI (Gemini) - interpretación de imágenes del bot (fotos de pedidos)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Configuración de Aplicación
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ====================================
# Instrucciones:
# 1. Copiar este archivo: cp .env.example .env
# 2. Completar con valores reales
# 3. NO commitear el archivo .env
# ====================================

# ====================================
# Alternativa a DATABASE_URL (la usa el deploy en Render)
# ====================================
# Si DATABASE_URL no esta seteada, la URL JDBC se arma con estas tres partes.
# En Render las inyecta el propio Blueprint desde la base (fromDatabase), asi
# que no hay que escribir la cadena de conexion a mano en ningun lado.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dioburger
